{
  "expo": {
    "name": "oflo",
    "slug": "oflo",
    "scheme": "oflo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.oflo"
    },
    "plugins": [
      "expo-router"
    ],
    "android": {
      "package": "com.anonymous.oflo"
    }
  }
}
